{
  "name": "promptvault",
  "private": true,
  "version": "1.0.0",
  "description": "An open-source, privacy-first library to save, organise, search and reuse AI prompts and creative assets.",
  "license": "MIT",
  "author": "Raghav Kapoor",
  "homepage": "https://kapoorraghav-cmd.github.io/promptvault/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kapoorraghav-cmd/promptvault.git"
  },
  "bugs": "https://github.com/kapoorraghav-cmd/promptvault/issues",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/copy-ocr-assets.mjs",
    "dev": "npm run prepare-assets && vite",
    "build": "npm run prepare-assets && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "diff": "^9.0.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.69.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
